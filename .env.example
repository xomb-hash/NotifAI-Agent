# =====================================================================
#   NotifAI Enterprise - Environment Configuration
# =====================================================================
# Google Gemini API (required)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector Store (Chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=notifai_notices

# Google Calendar OAuth
GOOGLE_CALENDAR_CREDENTIALS=./langcredentials.json
GOOGLE_CALENDAR_TOKEN=./token.json
GOOGLE_CALENDAR_ID=primary

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=

# Observability
OTEL_ENDPOINT=
LOG_LEVEL=INFO

# RAG Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
RELEVANCE_THRESHOLD=0.7

# Cost Tracking (USD per 1M tokens, Nov 2026 pricing)
GEMINI_INPUT_COST_PER_M=0.30
GEMINI_OUTPUT_COST_PER_M=2.50
GEMINI_EMBEDDING_COST_PER_M=0.02

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Multi-Agent
MAX_VALIDATION_RETRIES=2
AGENT_TEMPERATURE=0.0

# Sarvam AI (optional, for Indic voice + LLM)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4

# Server (legacy)
PORT=5005