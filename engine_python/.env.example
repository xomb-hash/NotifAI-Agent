# =====================================================================
#   NotifAI Enterprise - Engine Python Environment Configuration
# =====================================================================
# Primary Sarvam AI Configuration (Strictly Sarvam models for reasoning & speech)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# Sarvam Voice ASR Configuration (Saaras v4 translates Hindi/Hinglish to English)
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=translate

# Google Calendar (Google APIs strictly for calendar scheduling)
# Place your Google Cloud OAuth client secret in langcredentials.json
# Run agent.py locally or with browser to generate token.json
GOOGLE_CALENDAR_ID=primary

# Server Configuration
PORT=5005
